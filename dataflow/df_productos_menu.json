{
	"name": "df_productos_menu",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "productos_menu_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "productos_menu_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          producto_id as string,",
				"          nombre_producto as string,",
				"          categoria as string,",
				"          precio_lista as string,",
				"          costo_estimado as string,",
				"          disponible as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(categoria = initCap(lower(trim(categoria))),",
				"          nombre_producto = initCap(lower(trim(nombre_producto))),",
				"          precio_lista = initCap(lower(trim(precio_lista))),",
				"          costo_estimado = initCap(lower(trim(costo_estimado))),",
				"          disponible = initCap(lower(trim(disponible)))) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(producto_id) && !isNull(precio_lista) && !isNull(costo_estimado) && !isNull(categoria),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"aggregate1 derive(precio_lista = toDecimal(precio_lista),",
				"          costo_estimado = toDecimal(costo_estimado),",
				"          producto_menu_id = producto_id,",
				"          nombre_producto = nombre_producto,",
				"          categoria = categoria,",
				"          disponible = disponible) ~> derivedColumn2",
				"split1@validos aggregate(groupBy(producto_id),",
				"     nombre_producto = first(nombre_producto),",
				"          categoria = first(categoria),",
				"          precio_lista = first(precio_lista),",
				"          costo_estimado = first(costo_estimado),",
				"          disponible = first(disponible)) ~> aggregate1",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          producto_menu_id as string,",
				"          nombre_item as string,",
				"          categoria as string,",
				"          precio as decimal(12,2),",
				"          disponible as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          producto_menu_id,",
				"          nombre_item = nombre_producto,",
				"          categoria,",
				"          precio = costo_estimado,",
				"          disponible",
				"     )) ~> sink1"
			]
		}
	}
}