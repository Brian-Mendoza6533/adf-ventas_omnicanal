{
	"name": "df_restaurantes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "restaurantes_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "restaurantes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          restaurante_id as string,",
				"          nombre_restaurante as string,",
				"          tipo_cocina as string,",
				"          calificacion_promedio as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(calificacion_promedio = toFloat(calificacion_promedio),",
				"          nombre_restaurante = iif(isNull(nombre_restaurante), 'Sin Nombre', nombre_restaurante),",
				"          activo = iif(lower(trim(activo)) == 'sí' || lower(trim(activo)) == 'si' || lower(trim(activo)) == 'activo' || lower(trim(activo)) == 'true' || lower(trim(activo)) == '1', 'Activo', 'Inactivo')) ~> derivedColumn1",
				"derivedColumn1 aggregate(groupBy(restaurante_id),",
				"     nombre_restaurante = first(nombre_restaurante),",
				"          tipo_cocina = first(tipo_cocina),",
				"          calificacion_promedio = first(calificacion_promedio),",
				"          activo = first(activo)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          restaurante_id as string,",
				"          nombre_restaurante as string,",
				"          tipo_cocina as string,",
				"          ciudad as string,",
				"          estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          restaurante_id,",
				"          nombre_restaurante,",
				"          tipo_cocina,",
				"          estado = activo",
				"     )) ~> sink1"
			]
		}
	}
}